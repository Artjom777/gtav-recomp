+    if (dash != std::string::npos) {
+      lo = uint32_t(std::stoul(spec.substr(0, dash), nullptr, 16));
+      hi = uint32_t(std::stoul(spec.substr(dash + 1), nullptr, 16));
+    }
+    budget = 5000;
+  }
