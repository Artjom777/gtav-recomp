+        auto *vulkanDevice = static_cast<VulkanDevice *>(device);
+        std::vector<uint8_t> data;
+        size_t size = 0;
+        if (vulkanDevice == nullptr || vulkanDevice->pipelineCache == VK_NULL_HANDLE ||
